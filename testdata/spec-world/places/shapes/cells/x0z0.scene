# jayzee-scene v2 yaml x0z0
shape-sphere:
  id: shape-sphere
  primitive: { kind: scripted, script: scripts/shapes.js, params: { kind: sphere } }
  feetPosition: { x: -4, y: 0, z: 0 }
  physics: static
shape-cylinder:
  id: shape-cylinder
  primitive: { kind: scripted, script: scripts/shapes.js, params: { kind: cylinder } }
  feetPosition: { x: 0, y: 0, z: 0 }
  physics: static
shape-capsule:
  id: shape-capsule
  primitive: { kind: scripted, script: scripts/shapes.js, params: { kind: capsule } }
  feetPosition: { x: 4, y: 0, z: 0 }
  physics: static
